# ------------------------------------------------------------------------------
# 5. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
# Log level: debug | info | warn | error (default: 'info' in prod, 'debug' in dev)
LOG_LEVEL="info"

# Secret bearer token to secure /api/monitoring endpoint from unauthorized access
# Generate with `openssl rand -hex 24`
MONITORING_SECRET=""

# ------------------------------------------------------------------------------
# 6. CONTAINER & DEPLOYMENT FLAGS (Optional)
# ------------------------------------------------------------------------------
# Set to 'true' if building standalone Docker container output
STANDALONE="false"

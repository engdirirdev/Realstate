# ==============================================================================
# KIRO-MAAL REAL ESTATE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` or `.env.local` for local development,
# or populate your cloud container secrets store (AWS SSM, Vercel, Docker Secrets).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Options: development | test | production
NODE_ENV="development"

# Server network binding
PORT=3000
HOST="0.0.0.0"

# Public application base URL (used for canonical links, emails, OpenGraph)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE (Prisma ORM & MySQL / PlanetScale / AWS RDS)
# ------------------------------------------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&connection_limit=20
DATABASE_URL="mysql://root:@localhost:3306/real_estate_ai"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
# CRITICAL FOR PRODUCTION: Generate with `openssl rand -base64 32`
# Must be at least 32 characters long. Never commit your production secret!
AUTH_SECRET="your-super-secret-auth-secret-here"

# Application URL for NextAuth callbacks & CSRF verification
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE ENGINES
# ------------------------------------------------------------------------------
# Google Gemini API Key
# Obtain at: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"


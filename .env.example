# Environment Variables for Real Estate AI System
# Copy this file to .env and fill in your values

# -----------------------------------------------
# DATABASE
# -----------------------------------------------
# MySQL connection string (XAMPP local development)
DATABASE_URL="mysql://root:@localhost:3306/real_estate_ai"

# -----------------------------------------------
# AUTHENTICATION (Auth.js / NextAuth v5)
# -----------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-auth-secret-here"

# Application URL
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------
# AI - GOOGLE GEMINI API
# -----------------------------------------------
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY="your-google-gemini-api-key-here"

# -----------------------------------------------
# AI - OPENAI API
# -----------------------------------------------
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"
# Default: gpt-4o-mini (fast, cost-effective, multilingual & structured outputs)
OPENAI_MODEL="gpt-4o-mini"

# -----------------------------------------------
# OPTIONAL: Production overrides
# -----------------------------------------------
# NODE_ENV="production"
# NEXTAUTH_URL="https://your-production-domain.com"

{
  "name": "real-estate-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-dev.js && next dev --turbopack",
    "dev:webpack": "node scripts/prepare-dev.js && next dev",
    "build": "next build",
    "start": "next start",
    "prod": "next build && next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "mobile:assets": "node scripts/generate-android-assets.mjs",
    "mobile:sync": "npx cap sync android",
    "mobile:dev": "node -e \"process.env.CAPACITOR_SERVER_URL='http://10.0.2.2:3000'; require('child_process').execSync('npx cap sync android', { stdio: 'inherit' });\"",
    "mobile:open": "npx cap open android",
    "test:phase1": "node tests/phase1-verification.mjs",
    "test:phase2a": "node tests/phase2a-semantic-search.mjs",
    "test:phase2b": "node tests/phase2b-hybrid-search.mjs",
    "test:phase2c": "npx tsx tests/phase2c-personalized-recommendations.mjs",
    "test:phase3": "npx tsx tests/phase3-valuation-ml.mjs",
    "test:conversational": "npx tsx tests/conversational-ai-memory.mjs",
    "test:conversational-quality": "npx tsx tests/conversational-ai-quality-correction.mjs",
    "test:somali-nlu": "npx tsx tests/somali-nlu-location.mjs",
    "test:master-conversational": "npx tsx tests/master-conversational-ai.mjs",
    "test:caching": "npx tsx tests/caching-verification.mjs",
    "test:error-handling": "npx tsx tests/error-handling-verification.mjs",
    "test:production": "npx tsx tests/production-readiness-verification.mjs",
    "test:seo": "npx tsx tests/seo-verification.mjs",
    "test:scalability": "npx tsx tests/scalability-verification.mjs",
    "test:ux": "npx tsx tests/ux-review-verification.mjs",
    "test": "node tests/phase1-verification.mjs && node tests/phase2a-semantic-search.mjs && node tests/phase2b-hybrid-search.mjs && npx tsx tests/phase2c-personalized-recommendations.mjs && npx tsx tests/phase3-valuation-ml.mjs && npx tsx tests/conversational-ai-memory.mjs && npx tsx tests/conversational-ai-quality-correction.mjs && npx tsx tests/somali-nlu-location.mjs && npx tsx tests/master-conversational-ai.mjs && npx tsx tests/caching-verification.mjs && npx tsx tests/error-handling-verification.mjs && npx tsx tests/production-readiness-verification.mjs && npx tsx tests/seo-verification.mjs && npx tsx tests/scalability-verification.mjs && npx tsx tests/ux-review-verification.mjs",
    "postinstall": "node scripts/patch-next-overlay.js"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "15.1.3",
    "next-auth": "^5.0.0-beta.25",
    "openai": "^7.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^7.6.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^8",
    "eslint-config-next": "15.1.3",
    "postcss": "^8.5.26",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "core-js@3.29.1": true,
    "sharp@0.33.5": true,
    "unrs-resolver@1.12.2": true
  }
}

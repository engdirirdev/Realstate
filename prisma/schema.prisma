// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================
// ENUMS
// =============================================

enum Role {
  USER
  ADMIN
  CUSTOMER
}

enum PropertyType {
  HOUSE
  APARTMENT
  VILLA
  OFFICE
  LAND
  COMMERCIAL
  TOWNHOUSE
  STUDIO
  SHOP
  WAREHOUSE
  OTHER
}

enum PropertyStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
  SOLD
  RENTED
  INACTIVE
  UNAVAILABLE
  PAYMENT_PENDING
  EXPIRED
  CANCELLED
  ARCHIVED
}

enum RequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  PAYMENT_PENDING
  ACTIVE
  EXPIRED
  COMPLETED
}

enum TransactionType {
  SALE
  RENTAL
}

enum TransactionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PAYMENT_PENDING
  PAID
  COMPLETED
  ACTIVE
  EXPIRED
  REJECTED
  CANCELLED
}

enum InquiryStatus {
  NEW
  READ
  RESPONDED
  CLOSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum NotificationType {
  RECOMMENDATION
  PRICE_ALERT
  PROPERTY_UPDATE
  SYSTEM
  WELCOME
  INQUIRY
  BOOKING
  PAYMENT
  TRANSACTION
}

enum InteractionType {
  VIEW
  CLICK
  FAVORITE
  UNFAVORITE
  INQUIRY
  SEARCH_CLICK
  SAVE
  UNSAVE
  SHARE
}

// =============================================
// USERS
// =============================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  phone         String?
  password      String
  image         String?
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  preferences       UserPreference?
  favorites         Favorite[]
  searchHistory     SearchHistory[]
  recommendations   Recommendation[]
  chatSessions      ChatSession[]
  notifications     Notification[]
  pricePredictions  PricePrediction[]
  managedProperties Property[]        @relation("ManagerProperties")
  customerInquiries Inquiry[]         @relation("CustomerInquiries")
  managerInquiries  Inquiry[]         @relation("ManagerInquiries")
  customerBookings  Booking[]         @relation("CustomerBookings")
  managerBookings   Booking[]         @relation("ManagerBookings")
  customerPayments  Payment[]         @relation("CustomerPayments")
  managerPayments   Payment[]         @relation("ManagerPayments")
  reviews           Review[]
  listingReports    ListingReport[]
  interactions      UserInteraction[]
  preferenceProfile UserPreferenceProfile?
  customerPurchaseRequests PurchaseRequest[] @relation("CustomerPurchaseRequests")
  managerPurchaseRequests  PurchaseRequest[] @relation("ManagerPurchaseRequests")
  customerRentalRequests   RentalRequest[]   @relation("CustomerRentalRequests")
  managerRentalRequests    RentalRequest[]   @relation("ManagerRentalRequests")
  customerTransactions     Transaction[]     @relation("CustomerTransactions")
  managerTransactions      Transaction[]     @relation("ManagerTransactions")

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

// =============================================
// USER PREFERENCES
// =============================================

model UserPreference {
  id                 String        @id @default(cuid())
  userId             String        @unique
  preferredLocation  String?
  minBudget          Float?
  maxBudget          Float?
  preferredType      PropertyType?
  preferredBedrooms  Int?
  preferredBathrooms Int?
  preferredMinArea   Float?
  preferredMaxArea   Float?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// =============================================
// PROPERTIES
// =============================================

model Property {
  id              String         @id @default(cuid())
  title           String
  description     String         @db.Text
  price           Float
  location        String
  city            String
  address         String?
  latitude        Float?
  longitude       Float?
  type            PropertyType
  status          PropertyStatus @default(PENDING)
  bedrooms        Int
  bathrooms       Int
  area            Float // in square meters
  yearBuilt       Int?
  amenities       String?        @db.Text // JSON array stored as text
  isFeatured      Boolean        @default(false)
  viewCount       Int            @default(0)
  managerId       String?
  rejectionReason String?        @db.Text
  videoUrl        String?
  floorPlanUrl    String?
  virtualTourUrl  String?
  parking         Int?           @default(0)
  isFurnished     Boolean        @default(false)
  lotSize         Float?
  listingType     String?        @default("FOR_SALE")
  currency        String         @default("USD")
  isNegotiable    Boolean        @default(false)
  rentPeriod      String?        // MONTHLY | WEEKLY | DAILY (FOR_RENT only)
  securityDeposit Float?         // FOR_RENT only
  typeDetails     String?        @db.Text // JSON object storing type-specific details
  approvalStatus     String?        @default("APPROVED") // DRAFT | PENDING_REVIEW | APPROVED | REJECTED
  availabilityStatus String?        @default("AVAILABLE") // AVAILABLE | BOOKING_PENDING | RENTED | RENT_EXPIRED | SOLD | INACTIVE
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  manager          User?              @relation("ManagerProperties", fields: [managerId], references: [id], onDelete: SetNull)
  images           PropertyImage[]
  documents        PropertyDocument[]
  reviews          Review[]
  favorites        Favorite[]
  recommendations  Recommendation[]
  pricePredictions PricePrediction[]
  inquiries        Inquiry[]
  bookings         Booking[]
  payments         Payment[]
  reports          ListingReport[]
  embedding        PropertyEmbedding?
  interactions     UserInteraction[]
  purchaseRequests PurchaseRequest[]
  rentalRequests   RentalRequest[]
  transactions     Transaction[]

  @@index([location])
  @@index([city])
  @@index([price])
  @@index([type])
  @@index([bedrooms])
  @@index([status])
  @@index([approvalStatus])
  @@index([availabilityStatus])
  @@index([isActive])
  @@index([listingType])
  @@index([isFeatured])
  @@index([managerId])
  @@map("properties")
}

// =============================================
// PROPERTY EMBEDDINGS (PHASE 2A)
// =============================================

model PropertyEmbedding {
  id          String   @id @default(cuid())
  propertyId  String   @unique
  embedding   String   @db.LongText
  model       String   @default("gemini-embedding-2")
  version     String   @default("v1")
  dimension   Int      @default(768)
  sourceHash  String   @db.VarChar(64)
  sourceText  String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([model])
  @@map("property_embeddings")
}

// =============================================
// PROPERTY IMAGES
// =============================================

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  altText    String?
  isPrimary  Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

// =============================================
// INQUIRIES
// =============================================

model Inquiry {
  id         String        @id @default(cuid())
  propertyId String
  customerId String
  managerId  String?
  subject    String?
  message    String        @db.Text
  response   String?       @db.Text
  status     InquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  customer User     @relation("CustomerInquiries", fields: [customerId], references: [id], onDelete: Cascade)
  manager  User?    @relation("ManagerInquiries", fields: [managerId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([customerId])
  @@index([managerId])
  @@index([status])
  @@map("inquiries")
}

// =============================================
// BOOKINGS
// =============================================

model Booking {
  id         String        @id @default(cuid())
  propertyId String
  customerId String
  managerId  String?
  startDate  DateTime?
  endDate    DateTime?
  totalPrice Float
  status     BookingStatus @default(PENDING)
  notes      String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  customer User      @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  manager  User?     @relation("ManagerBookings", fields: [managerId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([propertyId])
  @@index([customerId])
  @@index([managerId])
  @@index([status])
  @@map("bookings")
}

// =============================================
// PAYMENTS
// =============================================

model Payment {
  id             String        @id @default(cuid())
  bookingId      String?
  propertyId     String?
  customerId     String
  managerId      String?
  amount         Float
  currency       String        @default("USD")
  paymentMethod  String        @default("DEMO / SANDBOX")
  status         PaymentStatus @default(PAID)
  transactionRef String        @unique
  receiptUrl     String?
  transactionId  String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  booking     Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  property    Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  customer    User         @relation("CustomerPayments", fields: [customerId], references: [id], onDelete: Cascade)
  manager     User?        @relation("ManagerPayments", fields: [managerId], references: [id], onDelete: SetNull)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  receipt     Receipt?

  @@index([customerId])
  @@index([managerId])
  @@index([status])
  @@index([transactionRef])
  @@index([transactionId])
  @@map("payments")
}

// =============================================
// PURCHASE / RENTAL REQUESTS, TRANSACTIONS, RECEIPTS
// =============================================

model PurchaseRequest {
  id           String        @id @default(cuid())
  requestNo    String        @unique
  customerId   String
  propertyId   String
  managerId    String?
  salePrice    Float
  currency     String        @default("USD")
  status       RequestStatus @default(PENDING)
  notes        String?       @db.Text
  reviewNotes  String?       @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customer    User         @relation("CustomerPurchaseRequests", fields: [customerId], references: [id], onDelete: Cascade)
  manager     User?        @relation("ManagerPurchaseRequests", fields: [managerId], references: [id], onDelete: SetNull)
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  transaction Transaction?

  @@index([customerId])
  @@index([propertyId])
  @@index([managerId])
  @@index([status])
  @@map("purchase_requests")
}

model RentalRequest {
  id              String        @id @default(cuid())
  requestNo       String        @unique
  customerId      String
  propertyId      String
  managerId       String?
  startDate       DateTime
  endDate         DateTime
  rentalPeriod    String // MONTHLY | WEEKLY | DAILY
  periods         Int
  rentAmount      Float
  securityDeposit Float         @default(0)
  totalAmount     Float
  currency        String        @default("USD")
  status          RequestStatus @default(PENDING)
  bookingStatus   String?       @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  rentalStatus    String?                           // ACTIVE | EXPIRED | COMPLETED | CANCELLED
  agreementNo     String?
  approvedAt      DateTime?
  notes           String?       @db.Text
  reviewNotes     String?       @db.Text
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer    User         @relation("CustomerRentalRequests", fields: [customerId], references: [id], onDelete: Cascade)
  manager     User?        @relation("ManagerRentalRequests", fields: [managerId], references: [id], onDelete: SetNull)
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  transaction Transaction?

  @@index([customerId])
  @@index([propertyId, startDate, endDate])
  @@index([managerId])
  @@index([status])
  @@index([bookingStatus])
  @@index([rentalStatus])
  @@index([agreementNo])
  @@map("rental_requests")
}

model Transaction {
  id                String            @id @default(cuid())
  txnNo             String            @unique
  type              TransactionType
  customerId        String
  managerId         String?
  propertyId        String
  amount            Float
  currency          String            @default("USD")
  status            TransactionStatus @default(PENDING)
  purchaseRequestId String?           @unique
  rentalRequestId   String?           @unique
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  customer        User             @relation("CustomerTransactions", fields: [customerId], references: [id], onDelete: Cascade)
  manager         User?            @relation("ManagerTransactions", fields: [managerId], references: [id], onDelete: SetNull)
  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  rentalRequest   RentalRequest?   @relation(fields: [rentalRequestId], references: [id], onDelete: SetNull)
  payments        Payment[]
  receipt         Receipt?

  @@index([customerId])
  @@index([managerId])
  @@index([propertyId])
  @@index([status])
  @@index([type])
  @@map("transactions")
}

model Receipt {
  id            String   @id @default(cuid())
  receiptNo     String   @unique
  transactionId String   @unique
  paymentId     String   @unique
  details       String   @db.Text // JSON snapshot at time of payment
  issuedAt      DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

// =============================================
// FAVORITES
// =============================================

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@map("favorites")
}

// =============================================
// SEARCH HISTORY
// =============================================

model SearchHistory {
  id           String        @id @default(cuid())
  userId       String
  query        String?
  location     String?
  minPrice     Float?
  maxPrice     Float?
  bedrooms     Int?
  propertyType PropertyType?
  resultsCount Int           @default(0)
  name         String?
  isSaved      Boolean       @default(false)
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isSaved])
  @@index([createdAt])
  @@map("search_history")
}

// =============================================
// RECOMMENDATIONS
// =============================================

model Recommendation {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  score      Float // 0-100 match score
  reasons    String   @db.Text // JSON array of reason strings
  isViewed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@index([score])
  @@map("recommendations")
}

// =============================================
// USER INTERACTIONS & BEHAVIORAL AI (PHASE 2C)
// =============================================

model UserInteraction {
  id         String          @id @default(cuid())
  userId     String
  propertyId String?
  eventType  InteractionType
  weight     Float           @default(1.0)
  metadata   String?         @db.Text
  createdAt  DateTime        @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([propertyId])
  @@index([eventType])
  @@map("user_interactions")
}

model UserPreferenceProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  confidence        Float    @default(0.0)
  totalInteractions Int      @default(0)
  totalWeight       Float    @default(0.0)
  preferredCities   String?  @db.Text
  preferredTypes    String?  @db.Text
  minPrice          Float?
  maxPrice          Float?
  avgPrice          Float?
  preferredBeds     Float?
  preferredBaths    Float?
  amenities         String?  @db.Text
  semanticVector    String?  @db.LongText
  lastActiveAt      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([confidence])
  @@map("user_preference_profiles")
}

// =============================================
// PRICE PREDICTIONS
// =============================================

model PricePrediction {
  id             String       @id @default(cuid())
  userId         String
  propertyId     String? // Optional - can predict for any property
  location       String
  propertyType   PropertyType
  area           Float
  bedrooms       Int
  bathrooms      Int
  yearBuilt      Int?
  predictedPrice Float
  minPrice       Float
  maxPrice       Float
  confidence     Float // 0-100
  modelVersion   String       @default("v1.0")
  mae            Float? // Mean Absolute Error
  rmse           Float? // Root Mean Squared Error
  r2Score        Float? // R² Score
  createdAt      DateTime     @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([location])
  @@index([propertyType])
  @@map("price_predictions")
}

// =============================================
// CHAT SESSIONS
// =============================================

model ChatSession {
  id        String   @id @default(cuid())
  userId    String?
  title     String   @default("New Conversation")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@index([createdAt])
  @@map("chat_sessions")
}

// =============================================
// CHAT MESSAGES
// =============================================

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // "user" | "assistant"
  content   String   @db.Text
  metadata  String?  @db.Text // JSON - property IDs referenced, intent detected, etc.
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

// =============================================
// CONTACT MESSAGES
// =============================================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@map("contact_messages")
}

// =============================================
// NOTIFICATIONS
// =============================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  linkUrl   String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// =============================================
// PROPERTY DOCUMENTS
// =============================================

model PropertyDocument {
  id         String   @id @default(cuid())
  propertyId String
  title      String
  fileUrl    String
  fileType   String?
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_documents")
}

// =============================================
// REVIEWS & RATINGS
// =============================================

model Review {
  id         String   @id @default(cuid())
  propertyId String
  userId     String
  rating     Int      @default(5)
  comment    String   @db.Text
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([userId])
  @@map("reviews")
}

// =============================================
// AUDIT LOGS
// =============================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================
// SYSTEM SETTINGS
// =============================================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// =============================================
// CATEGORIES & LOCATIONS
// =============================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  slug        String   @unique
  createdAt   DateTime @default(now())

  @@map("categories")
}

model Location {
  id        String   @id @default(cuid())
  city      String
  region    String
  country   String   @default("Somalia")
  createdAt DateTime @default(now())

  @@unique([city, region])
  @@map("locations")
}

// =============================================
// LISTING REPORTS
// =============================================

model ListingReport {
  id         String   @id @default(cuid())
  propertyId String
  userId     String?
  reason     String
  details    String?  @db.Text
  status     String   @default("PENDING") // PENDING, REVIEWED, DISMISSED
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([userId])
  @@index([status])
  @@map("listing_reports")
}

